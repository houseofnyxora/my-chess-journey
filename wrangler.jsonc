{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-chess-journey",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/room/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHESS_ROOMS",
        "class_name": "ChessRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChessRoom"
      ]
    }
  ]
}